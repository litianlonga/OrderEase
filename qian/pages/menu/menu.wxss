.container {
  padding: 20rpx;
}

.search {
  display: flex;
  margin-bottom: 20rpx;
}

.search input {
  flex: 1;
  padding: 10rpx;
  border: 1px solid #ddd;
  border-radius: 5rpx;
  margin-right: 10rpx;
}

.categories {
  display: flex;
  overflow-x: auto;
  margin-bottom: 20rpx;
}

.category-item {
  padding: 10rpx 20rpx;
  margin-right: 10rpx;
  background: #f5f5f5;
  border-radius: 5rpx;
  white-space: nowrap;
}

.category-item.active {
  background: #07c160;
  color: #fff;
}

.dishes {
  margin-bottom: 100rpx;
}

.dish-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1px solid #eee;
}

.dish-info {
  flex: 1;
}

.dish-name {
  font-size: 32rpx;
  margin-bottom: 10rpx;
}

.dish-price {
  color: #f00;
}

.add-btn {
  padding: 10rpx 20rpx;
  background: #07c160;
  color: #fff;
  border-radius: 5rpx;
}

.cart {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.1);
}

.cart-items {
  max-height: 400rpx;
  overflow-y: auto;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.order-btn {
  width: 100%;
  background: #07c160;
  color: #fff;
  margin-top: 20rpx;
}


.search-box {
  background: #fff;
  padding: 20rpx;
  display: flex;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-box input {
  flex: 1;
  background: #f5f5f5;
  height: 70rpx;
  border-radius: 35rpx;
  padding: 0 30rpx;
  margin-right: 20rpx;
}

.categories {
  padding: 20rpx;
  white-space: nowrap;
  overflow-x: auto;
  background: #fff;
  margin: 20rpx 0;
}

.category-item {
  display: inline-block;
  padding: 15rpx 30rpx;
  margin-right: 20rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  transition: all 0.3s;
}

.category-item.active {
  background: #07c160;
  color: #fff;
}

.dishes {
  padding: 20rpx;
}

.dish-item {
  background: #fff;
  border-radius: 15rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dish-info {
  flex: 1;
}

.dish-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.dish-price {
  color: #f56c6c;
  font-size: 30rpx;
}

.add-btn {
  background: #07c160;
  color: #fff;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.dish-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.dish-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.menu-container {
  display: flex;
  height: 100vh;
  background: #f8f8f8;
}

.categories {
  width: 80rpx;
  background: #fff;
  padding: 10rpx 0;
  box-shadow: 2rpx 0 10rpx rgba(0,0,0,0.05);
  position: fixed;
  left: 0;
  top: 140rpx;
  bottom: 0;
  z-index: 10;
  overflow-y: auto;
  display: block;
}

.category-item {
  padding: 20rpx 5rpx;
  margin: 5rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
  writing-mode: vertical-rl;
  text-orientation: upright;
  min-height: 120rpx;
  width: 100%;
  display: flex;
  align-items: center;  /* 垂直居中 */
  justify-content: center;  /* 水平居中 */
  text-align: center;  /* 文字居中 */
}

/* 相应调整右侧内容区域的边距 */
.dishes {
  margin-left: 80rpx;
}

.cart {
  left: 80rpx;
}

.category-item.active {
  color: #4A90E2;
  background: #f0f7ff;
  font-weight: 500;
}

.category-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  height: 60%;
  width: 6rpx;
  background: #4A90E2;
}

