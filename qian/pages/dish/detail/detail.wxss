.container {
  min-height: 100vh;
  background: #f8f8f8;
}

.dish-image {
  width: 100%;
  height: 500rpx;
}

.dish-info {
  background: #fff;
  padding: 30rpx;
  margin-top: -40rpx;
  border-radius: 40rpx 40rpx 0 0;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
}

.price {
  color: #ff4d4f;
  font-size: 32rpx;
  font-weight: bold;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: block;
}

.description {
  margin-bottom: 40rpx;
}

.content {
  color: #666;
  font-size: 28rpx;
  line-height: 1.6;
}

.info-item {
  display: flex;
  margin-bottom: 20rpx;
}

.label {
  color: #999;
  width: 160rpx;
}

.value {
  color: #333;
  flex: 1;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.add-to-cart {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07c160;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
}