<view class="container">
  <view class="order-list" hidden="{{showDetail}}">
    <view class="order-item" wx:for="{{orders}}" wx:key="id">
      <view class="order-content" bindtap="showOrderDetail" data-id="{{item.id}}">
        <view class="order-header">
          <text>订单号：{{item.id}}</text>
          <text>{{item.create_time}}</text>
        </view>
        <view class="order-info">
          <text>总价：¥{{item.total_price}}</text>
          <text class="status-{{item.status}}">
            {{item.status === 0 ? '待付款' : item.status === 1 ? '已付款' : '已完成'}}
          </text>
        </view>
      </view>
      <view class="delete-btn" catchtap="deleteOrder" data-id="{{item.id}}">删除</view>
    </view>
  </view>

  <view class="order-detail" hidden="{{!showDetail}}">
    <view class="detail-header">
      <text class="back" bindtap="hideDetail">返回</text>
      <text>订单详情</text>
    </view>
    
    <view class="detail-items">
      <view class="detail-item" wx:for="{{currentOrder.details}}" wx:key="id">
        <text>{{item.dish_name}}</text>
        <view class="item-right">
          <text>x{{item.quantity}}</text>
          <text>¥{{item.price * item.quantity}}</text>
          <text class="delete-dish" catchtap="deleteDish" data-id="{{item.id}}">删除</text>
        </view>
      </view>
    </view>

    <view class="detail-footer">
      <view class="total">总计：¥{{currentOrder.total_price}}</view>
      <button class="add-more-btn" bindtap="addMoreDishes" 
              wx:if="{{currentOrder.status === 0}}">
        加菜
      </button>
      <button class="pay-btn" bindtap="goToPayment" 
              wx:if="{{currentOrder.status === 0}}">
        去结算
      </button>
      <text class="status" wx:else>已付款</text>
    </view>
    <view class="status">
      状态：
      <text class="status-{{currentOrder.status}}">
        {{currentOrder.status === 0 ? '待付款' : currentOrder.status === 1 ? '已付款' : '已完成'}}
      </text>
    </view>
  </view>
</view>