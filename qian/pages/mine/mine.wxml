<view class="container">
  <view class="header">
    <image class="settings-btn" src="/images/settings.jpg" bindtap="goToSettings"></image>
    <view class="avatar-container" bindtap="chooseAvatar">
      <image class="avatar" src="{{userInfo.avatar}}" mode="aspectFill"/>
      <view class="avatar-placeholder" wx:if="{{!userInfo.avatar}}">上传头像</view>
    </view>
    <view class="header-info">
      <text class="username">{{userInfo.username}}</text>
      <text class="phone">{{userInfo.phone}}</text>
    </view>
  </view>

  <view class="menu-list">
    <navigator url="/pages/coupon/buy/buy" class="menu-item">
      <text>购买优惠券</text>
      <text class="arrow">></text>
    </navigator>
    <view class="menu-item" bindtap="goToMyCoupons">
      <text>我的优惠券</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToHistoryOrders">
      <text>历史订单</text>
      <text class="arrow">></text>
    </view>
  </view>
</view>