.container {
  padding: 30rpx;
  background: #f8f8f8;
  min-height: 100vh;
}

.header {
  position: relative;
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.settings-btn {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  width: 36rpx;  /* 减小尺寸 */
  height: 36rpx;  /* 减小尺寸 */
  padding: 8rpx;  /* 减小内边距 */
  border-radius: 50%;
  background: rgba(0,0,0,0.03);
}

.settings-btn:active {
  opacity: 0.8;
}

.avatar-container {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  overflow: hidden;
  margin-right: 30rpx;
  background: #f5f5f5;
}

.avatar {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.header-info {
  flex: 1;
}

.username {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  display: block;
}

.phone {
  font-size: 28rpx;
  color: #666;
}

.user-info {
  background: #FFFFFF;
  padding: 40rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-right: 30rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 500;
}

.menu-list {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item text {
  font-size: 28rpx;
}

.arrow {
  color: var(--light-text);
}

.logout-btn {
  margin-top: 60rpx;
  background: var(--error-color);
  color: #FFFFFF;
  border-radius: 40rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 28rpx;
}

.arrow {
  color: #999;
  font-size: 32rpx;
}

.label {
  color: #666;
}

.value {
  color: #333;
}

.logout-btn {
  width: 100%;
  background: #ff4d4f;
  color: #fff;
  border-radius: 40rpx;
  margin-top: 60rpx;
}

.logout-btn:active {
  opacity: 0.9;
}