<view class="container">
  <view class="price-section">
    <view class="original-price" wx:if="{{selectedCoupon}}">原价：¥{{originalPrice}}</view>
    <view class="price">需支付：¥{{totalPrice}}</view>
  </view>

  <view class="coupon-section">
    <view class="coupon-header" bindtap="showCouponList">
      <text>使用优惠券</text>
      <text class="coupon-status">{{selectedCoupon ? '已选择' : '未使用'}}</text>
    </view>
  </view>

  <view class="coupon-popup" wx:if="{{showCouponList}}">
    <view class="popup-mask" bindtap="hideCouponList"></view>
    <view class="popup-content">
      <view class="popup-header">
        <text>选择优惠券</text>
        <text class="close" bindtap="hideCouponList">×</text>
      </view>
      <view class="coupon-list">
        <radio-group bindchange="selectCoupon">
          <view class="coupon-item" wx:for="{{availableCoupons}}" wx:key="index">
            <radio value="{{index}}" />
            <view class="coupon-info">
              <text class="discount">{{item.discount * 10}}折</text>
              <text class="desc">适用于任意商品</text>
            </view>
          </view>
        </radio-group>
      </view>
    </view>
  </view>

  <!-- 原有的支付方式和按钮 -->
  <view class="payment-methods">
    <button class="payment-btn wx-btn" bindtap="showWxPayImage">
      微信支付
    </button>
    <button class="payment-btn ali-btn" bindtap="showAliPayImage">
      支付宝支付
    </button>
  </view>

  <view class="qr-code" wx:if="{{showWxPay}}">
    <image src="/images/微信.jpg" mode="aspectFit"></image>
  </view>

  <view class="qr-code" wx:if="{{showAliPay}}">
    <image src="/images/支付宝.jpg" mode="aspectFit"></image>
  </view>

  <button class="confirm-btn" bindtap="confirmPayment" 
          wx:if="{{showWxPay || showAliPay}}">
    我已完成付款
  </button>
</view>