.container {
  padding: 40rpx;
  background: #fff;
  border-radius: 20rpx;
  margin: 30rpx;
}

.price {
  font-size: 48rpx;
  font-weight: bold;
  text-align: center;
  margin: 40rpx 0;
  color: #f56c6c;
}

.payment-methods {
  display: flex;
  justify-content: space-around;
  margin: 60rpx 0;
}

.payment-btn {
  width: 280rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.wx-btn {
  background: linear-gradient(to right, #07c160, #0ab956);
  color: #fff;
}

.ali-btn {
  background: linear-gradient(to right, #1677ff, #0091ff);
  color: #fff;
}

.qr-code {
  text-align: center;
  margin: 40rpx 0;
  padding: 40rpx;
  background: #f8f8f8;
  border-radius: 20rpx;
}

.qr-code image {
  width: 400rpx;
  height: 400rpx;
  border-radius: 10rpx;
}

.confirm-btn {
  width: 90%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(to right, #07c160, #0ab956);
  color: #fff;
  font-size: 32rpx;
  margin-top: 60rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}


.price-section {
  text-align: center;
  margin-bottom: 30rpx;
}

.original-price {
  font-size: 28rpx;
  color: #999;
  text-decoration: line-through;
}

.coupon-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 30rpx;
  border-radius: 12rpx;
}

.coupon-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.coupon-status {
  color: #999;
  font-size: 28rpx;
}

.coupon-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.popup-mask {
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
}

.popup-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 20rpx 20rpx 0 0;
  padding: 30rpx;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.close {
  font-size: 40rpx;
}

.coupon-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.coupon-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.coupon-info {
  margin-left: 20rpx;
}

.discount {
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.desc {
  font-size: 26rpx;
  color: #999;
}