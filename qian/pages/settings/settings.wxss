.container {
  padding: 30rpx;
  background: #f8f8f8;
  min-height: 100vh;
}

.settings-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.settings-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.settings-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #666;
}

.value {
  font-size: 28rpx;
  color: #333;
}

.logout-btn {
  width: 100%;
  background: #ff4d4f;
  color: #fff;
  border-radius: 40rpx;
  margin-top: 60rpx;
  padding: 20rpx 0;
}

.logout-btn:active {
  opacity: 0.9;
}